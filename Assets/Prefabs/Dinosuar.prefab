  m_Script: {fileID: 11500000, guid: 00c079967b4a4664781bd76a53606a19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  highlight: {fileID: 1568327285, guid: c16b6624a8739d246a60f004c2626f43, type: 3}
  isClose: 1
  interactAction: {fileID: 1781555164194001046, guid: 2bcd2660ca9b64942af0de543d8d7100, type: 3}
  dialogue:
    Sentences:
    - CurrentSpeaker: {fileID: 11400000, guid: 3938c4cd391b64446b605f33007408cc, type: 2}
      Sentence: Are you worried for the upcoming director election?
    - CurrentSpeaker: {fileID: 11400000, guid: 0cbb8908e33b9a64a84fe91311a7fc67, type: 2}
      Sentence: A little, but I have faith that If I'm not reelected, the next person
        will uphold the ideals of Horizon.
    - CurrentSpeaker: {fileID: 11400000, guid: 3938c4cd391b64446b605f33007408cc, type: 2}
      Sentence: Well, you have my vote. You've sacraficed so much for Horizon, and
        yet you still look at the night sky with a child-like wonder.
